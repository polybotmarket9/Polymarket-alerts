# Copy to .env, fill in, then: set -a; . ./.env; set +a
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thresholds (these are the defaults)
BIG_TRADE_USD=10000
FRESH_WALLET_MIN_USD=2000
FRESH_WALLET_MAX_PRIOR_TRADES=5
PRICE_MOVE_POINTS=10
PRICE_MOVE_WINDOW_MIN=60
PRICE_MOVE_MAX_VOLUME_24H=100000

# What to watch
MARKET_TAG=crypto
EXCLUDE_KEYWORDS=up or down
MAX_MARKETS=300
POLL_SECONDS=60
