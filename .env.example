# Copy to .env, fill in, then: set -a; . ./.env; set +a
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Thresholds (these are the defaults)
BIG_TRADE_USD=10000
BIG_TRADE_USD_SPORTS=50000
FRESH_WALLET_MIN_USD=2000
FRESH_WALLET_MAX_PRIOR_TRADES=5
PRICE_MOVE_POINTS=10
PRICE_MOVE_WINDOW_MIN=60
PRICE_MOVE_MAX_VOLUME_24H=100000
PRICE_MOVE_MIN_VOLUME_24H=1000

WINNER_MIN_USD=2000
WINNER_MIN_PROFIT=10000
WINNER_MIN_RETURN=0.05
MAX_SIGNAL_PRICE=0.95
MAX_TRADE_AGE_MIN=15
REPEAT_HOURS=12
SUMMARY_DAYS=7

# What to watch
MARKET_TAGS=crypto,politics,sports,business
PRICE_MOVE_SKIP_CATEGORIES=sports
CLUSTER_WALLETS=3
CLUSTER_MIN_USD=1000
CLUSTER_TOTAL_USD=5000
CLUSTER_WINDOW_MIN=30
LATE_MAX_POINTS=10
EXCLUDE_KEYWORDS=up or down
MAX_MARKETS=300
POLL_SECONDS=60

# Only alert on bets you can place on polymarket.us (true/false), and how often to reload its markets.
US_ONLY=true
US_REFRESH_MIN=30
